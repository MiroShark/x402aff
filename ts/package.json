{
  "name": "x402aff",
  "version": "0.2.0",
  "description": "Builder-code affiliation for x402 sellers - the Affiliation facade (TypeScript port of affiliation.py).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/affiliation.d.ts",
      "default": "./dist/affiliation.js"
    }
  },
  "types": "./dist/affiliation.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "x402",
    "builder-codes",
    "0xsplits",
    "base",
    "affiliation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MiroShark/x402aff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiroShark/x402aff.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/MiroShark/x402aff/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "viem": "^2.52.0"
  }
}
